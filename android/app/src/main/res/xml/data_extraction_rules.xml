<?xml version="1.0" encoding="utf-8"?>
<!-- 控制通道 token 不能随备份带到别的设备 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
